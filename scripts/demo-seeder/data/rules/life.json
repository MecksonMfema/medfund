[
  {
    "ruleKey": "life.member-lifecycle.auto-terminate-arrears-6mo",
    "name": "Auto-terminate policies 6 months in arrears",
    "description": "LIFE policies more than 6 months in arrears are auto-terminated.",
    "category": "MEMBER_LIFECYCLE",
    "templateId": "member.auto-terminate",
    "priority": 100,
    "enabled": true,
    "definition": {
      "id": "life.member-lifecycle.auto-terminate-arrears-6mo",
      "name": "Auto-terminate 6mo arrears",
      "category": "MEMBER_LIFECYCLE",
      "priority": 100,
      "enabled": true,
      "conditions": {
        "operator": "AND",
        "items": [
          {"field": "member.arrearsMonths", "operator": ">=", "value": 6}
        ]
      },
      "action": {
        "type": "REJECT",
        "rejectionCode": "POLICY_TERMINATED",
        "message": "Policy auto-terminated: 6+ months in arrears."
      }
    }
  },
  {
    "ruleKey": "life.underwriting.occupation-hazard-loading",
    "name": "Occupation hazard premium loading",
    "description": "Members in HAZARDOUS occupations get a 1.5x premium loading.",
    "category": "UNDERWRITING",
    "templateId": "underwriting.occupation-loading",
    "priority": 95,
    "enabled": true,
    "definition": {
      "id": "life.underwriting.occupation-hazard-loading",
      "name": "Hazardous occupation loading",
      "category": "UNDERWRITING",
      "priority": 95,
      "enabled": true,
      "conditions": {
        "operator": "AND",
        "items": [
          {"field": "member.occupationClass", "operator": "==", "value": "HAZARDOUS"}
        ]
      },
      "action": {
        "type": "APPLY_LOADED_PREMIUM",
        "value": "1.5"
      }
    }
  },
  {
    "ruleKey": "life.underwriting.medical-risk-loading",
