    "category": "UNDERWRITING",
    "templateId": "underwriting.medical-loading",
    "priority": 94,
    "enabled": true,
    "definition": {
      "id": "life.underwriting.medical-risk-loading",
      "name": "Medical risk loading",
      "category": "UNDERWRITING",
      "priority": 94,
      "enabled": true,
      "conditions": {
        "operator": "AND",
        "items": [
          {"field": "member.medicalRiskClass", "operator": "==", "value": "HIGH"}
        ]
      },
      "action": {
        "type": "APPLY_LOADED_PREMIUM",
        "value": "1.25"
      }
    }
